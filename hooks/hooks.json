{
  "description": "Workflow plugin hooks: the public-repo scrub gate and the startup setup check (cross-platform)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__create_pull_request|mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__create_branch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scrub-guard.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/tier-check.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
